# --- LLM (required for real answers) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (reasoning depth / token spend per answer)
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (Claude API only). Set false on Bedrock/Vertex.
ANTHROPIC_ENABLE_FALLBACKS=true

# --- Observability (optional; traces are skipped when unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App ---
DATASET_PATH=data/unicorns_india_may2025.csv
LOG_DIR=logs
LOG_LEVEL=INFO
MAX_INPUT_CHARS=2000
MAX_TOOL_ROUNDS=6
MAX_HISTORY_TURNS=20
